<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RTools.Desktop.ViewModels"
        xmlns:models="using:RTools.Desktop.Models"
        x:Class="RTools.Desktop.DesktopWidgetWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="380"
        Height="620"
        MinWidth="320"
        MinHeight="480"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        CanResize="True"
        Topmost="True"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        Background="Transparent"
        Title="rtools 桌面挂件"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Icon>
        <WindowIcon>avares://RTools.Desktop/Assets/rtools.ico</WindowIcon>
    </Window.Icon>

    <Window.Styles>
        <Style Selector="Button.widgetTaskCheck">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="WidgetTaskRing"
                            Width="18"
                            Height="18"
                            CornerRadius="9"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource RtCheckboxBrush}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.widgetRowAction">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.18" />
                    <BrushTransition Property="Foreground"
                                     Duration="0:0:0.35" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.widgetTaskRow">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.widgetTaskRow.dragging">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.widgetTaskRow:pointerover Button.widgetRowAction">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.widgetDelete">
            <Setter Property="Foreground"
                    Value="{DynamicResource RtTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.widgetDelete:pointerover">
            <Setter Property="Foreground"
                    Value="{DynamicResource RtDangerBrush}" />
        </Style>
        <Style Selector="Button.widgetConfirmDelete">
            <Setter Property="Foreground"
                    Value="{DynamicResource RtDangerBrush}" />
        </Style>
        <Style Selector="Button.widgetCancelDelete">
            <Setter Property="Foreground"
                    Value="{DynamicResource RtTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.widgetCancelDelete:pointerover">
            <Setter Property="Foreground"
                    Value="{DynamicResource RtTextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.widgetTaskRow">
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.widgetTaskRow.dragging">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="Border.widgetTaskRow:pointerover">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background"
                                     Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.widgetInput">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.widgetTaskCheck:pointerover /template/ Border#WidgetTaskRing">
            <Setter Property="BorderBrush"
                    Value="{DynamicResource RtTextPrimaryBrush}" />
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="Button.widgetTaskCheck:pointerover">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.widgetTaskRow">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Border.widgetTaskRow.dragging">
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
        <Style Selector="Button.widgetIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.widgetIcon:pointerover">
            <Setter Property="Background" Value="#12FFFFFF" />
        </Style>
    </Window.Styles>

    <Grid Background="Transparent">
        <Border CornerRadius="14"
                Background="{DynamicResource RtSurfaceStrongBrush}"
                BorderBrush="{DynamicResource RtStrokeBrush}"
                BorderThickness="1"
                BoxShadow="0 10 32 0 #55000000">
            <Grid RowDefinitions="38,Auto,*">
                <Grid Grid.Row="0"
                      Margin="8,0,6,0"
                      ColumnDefinitions="*,Auto">
                    <Grid x:Name="WidgetDragRegion"
                          Background="Transparent">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding WidgetTitle}" />
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="0">
                        <Button Classes="widgetIcon"
                                Click="OnOpenMonthClicked"
                                ToolTip.Tip="月视图">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="M19,3H18V1H16V3H8V1H6V3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M19,19H5V8H19V19Z" />
                        </Button>
                        <Button Classes="widgetIcon"
                                Click="OnOpenSettingsClicked"
                                ToolTip.Tip="设置">
                            <PathIcon Width="13"
                                      Height="13"
                                      Data="M19.14,12.94C19.18,12.64 19.2,12.33 19.2,12C19.2,11.68 19.18,11.36 19.13,11.06L21.16,9.48C21.34,9.34 21.39,9.07 21.28,8.86L19.36,5.54C19.25,5.32 18.99,5.24 18.76,5.32L14.89,6.88C14.35,6.47 13.74,6.14 13.08,5.91L12.5,2.8C12.47,2.56 12.26,2.38 12,2.38H8.16C7.9,2.38 7.69,2.56 7.66,2.8L7.08,5.91C6.42,6.14 5.81,6.47 5.27,6.88L1.4,5.32C1.17,5.24 0.91,5.32 0.8,5.54L-1.12,8.86C-1.23,9.08 -1.18,9.36 -1,9.48L1.03,11.06C0.98,11.36 0.96,11.68 0.96,12C0.96,12.32 0.98,12.64 1.03,12.94L-1,14.52C-1.18,14.66 -1.23,14.93 -1.12,15.14L0.8,18.46C0.91,18.68 1.17,18.76 1.4,18.68L5.27,17.12C5.81,17.53 6.42,17.86 7.08,18.09L7.66,21.2C7.69,21.44 7.9,21.62 8.16,21.62H12C12.26,21.62 12.47,21.44 12.5,21.2L13.08,18.09C13.74,17.86 14.35,17.53 14.89,17.12L18.76,18.68C18.99,18.76 19.25,18.68 19.36,18.46L21.28,15.14C21.39,14.92 21.34,14.65 21.16,14.52L19.14,12.94M12,16C9.79,16 8,14.21 8,12S9.79,8 12,8S16,9.79 16,12S14.21,16 12,16Z" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="10,0,10,6"
                        Height="44"
                        Padding="9,0"
                        CornerRadius="8"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource RtStrokeBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Width="22"
                                Height="22"
                                MinWidth="22"
                                MinHeight="22"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding AddTaskCommand}"
                                ToolTip.Tip="添加任务">
                            <PathIcon Width="15"
                                      Height="15"
                                      Foreground="{DynamicResource RtTextSecondaryBrush}"
                                      Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                        </Button>
                        <TextBox Grid.Column="1"
                                 Classes="widgetInput"
                                 MinHeight="32"
                                 Height="32"
                                 Margin="7,0,6,0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 PlaceholderText="添加任务，按 Enter 创建..."
                                 Text="{Binding NewTaskTitle, Mode=TwoWay}"
                                 KeyDown="OnQuickAddKeyDown" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="5">
                            <Button Command="{Binding SetHighPriorityCommand}"
                                    ToolTip.Tip="高优先级"
                                    Width="16"
                                    Height="16"
                                    MinWidth="16"
                                    MinHeight="16"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Border Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        BorderBrush="#FFE05A5A"
                                        BorderThickness="2">
                                    <Border Width="8"
                                            Height="8"
                                            CornerRadius="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{Binding HighPriorityDotBrush}" />
                                </Border>
                            </Button>
                            <Button Command="{Binding SetMediumPriorityCommand}"
                                    ToolTip.Tip="中优先级"
                                    Width="16"
                                    Height="16"
                                    MinWidth="16"
                                    MinHeight="16"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Border Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        BorderBrush="#FFE8A838"
                                        BorderThickness="2">
                                    <Border Width="8"
                                            Height="8"
                                            CornerRadius="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{Binding MediumPriorityDotBrush}" />
                                </Border>
                            </Button>
                            <Button Command="{Binding SetLowPriorityCommand}"
                                    ToolTip.Tip="低优先级"
                                    Width="16"
                                    Height="16"
                                    MinWidth="16"
                                    MinHeight="16"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Border Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        BorderBrush="#FFA6A6AD"
                                        BorderThickness="2">
                                    <Border Width="8"
                                            Height="8"
                                            CornerRadius="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{Binding LowPriorityDotBrush}" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              Margin="10,0,10,2">
                    <StackPanel>
                        <ItemsControl x:Name="WidgetTaskList"
                                      ItemsSource="{Binding ActiveTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <Border Classes="widgetTaskRow"
                                            Classes.dragging="{Binding IsDragging}"
                                            PointerEntered="OnTaskRowPointerEntered"
                                            PointerExited="OnTaskRowPointerExited"
                                            PointerPressed="OnTaskRowPointerPressed"
                                            PointerMoved="OnTaskRowPointerMoved"
                                            PointerReleased="OnTaskRowPointerReleased"
                                            PointerCaptureLost="OnTaskRowPointerCaptureLost">
                                        <Grid ColumnDefinitions="3,28,*,Auto">
                                            <Border Grid.Column="0"
                                                    Width="3"
                                                    Margin="0,1"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource RtDangerBrush}"
                                                    IsVisible="{Binding IsHighPriority}" />
                                            <Border Grid.Column="0"
                                                    Width="3"
                                                    Margin="0,1"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource RtWarningBrush}"
                                                    IsVisible="{Binding IsMediumPriority}" />
                                            <Border Grid.Column="0"
                                                    Width="3"
                                                    Margin="0,1"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource RtTextTertiaryBrush}"
                                                    Opacity="0.45"
                                                    IsVisible="{Binding IsLowPriority}" />
                                            <Button Grid.Column="1"
                                                    Classes="widgetTaskCheck"
                                                    Command="{Binding $parent[Window].DataContext.ToggleCompleteCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="完成任务">
                                                <Grid Width="18" Height="18">
                                                    <Border Width="18"
                                                            Height="18"
                                                            CornerRadius="9"
                                                            BorderBrush="{DynamicResource RtCheckboxBrush}"
                                                            BorderThickness="2" />
                                                    <PathIcon Width="11"
                                                              Height="11"
                                                              IsVisible="{Binding IsCompleted}"
                                                              Foreground="{DynamicResource RtSuccessBrush}"
                                                              Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" />
                                                </Grid>
                                            </Button>
                                            <Border Grid.Column="2"
                                                    Margin="0,0,1,0"
                                                    Background="Transparent"
                                                    PointerPressed="OnTaskTitlePointerPressed">
                                                <StackPanel Spacing="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock FontSize="13"
                                                               LineHeight="17"
                                                               VerticalAlignment="Center"
                                                       Text="{Binding Title}"
                                                       FontWeight="Normal"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="4"
                                                                IsVisible="{Binding ReminderLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <PathIcon Width="9"
                                                                  Height="9"
                                                                  Foreground="{DynamicResource RtWarningBrush}"
                                                                  Data="M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,7H13V13H11V7M11,15H13V17H11V15Z" />
                                                        <TextBlock FontSize="9"
                                                                   Foreground="{DynamicResource RtTextSecondaryBrush}"
                                                                   Text="{Binding ReminderLabel}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                                <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal">
                                                <Button Classes="widgetRowAction widgetDelete"
                                                        IsVisible="{Binding !IsDeleteConfirming}"
                                                        Command="{Binding $parent[Window].DataContext.RequestDeleteTaskCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="删除">
                                                    <PathIcon Width="11"
                                                              Height="11"
                                                              Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                                                </Button>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="1"
                                                            IsVisible="{Binding IsDeleteConfirming}">
                                                    <Button Classes="widgetRowAction widgetConfirmDelete"
                                                            Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="确认删除">
                                                        <PathIcon Width="12"
                                                                  Height="12"
                                                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" />
                                                    </Button>
                                                    <Button Classes="widgetRowAction widgetCancelDelete"
                                                            Command="{Binding $parent[Window].DataContext.CancelDeleteTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="取消删除">
                                                        <PathIcon Width="11"
                                                                  Height="11"
                                                                  Data="M18.3,5.71L16.89,4.29L12,9.17L7.11,4.29L5.7,5.71L10.59,10.6L5.7,15.49L7.11,16.9L12,12.01L16.89,16.9L18.3,15.49L13.41,10.6L18.3,5.71Z" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="10,12,0,4"
                                   Classes="caption"
                                   FontWeight="SemiBold"
                                   Text="今日已完成"
                                   IsVisible="{Binding CompletedTasks.Count}" />
                        <ItemsControl ItemsSource="{Binding CompletedTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <Border Classes="widgetTaskRow" Opacity="0.62">
                                        <Grid ColumnDefinitions="3,28,*,Auto">
                                            <Border Width="3"
                                                    Margin="0,1"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource RtSuccessBrush}"
                                                    Opacity="0.65" />
                                            <Button Grid.Column="1"
                                                    Classes="widgetTaskCheck"
                                                    Command="{Binding $parent[Window].DataContext.ToggleCompleteCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="恢复任务">
                                                <Grid Width="18" Height="18">
                                                    <Border Width="18"
                                                            Height="18"
                                                            CornerRadius="9"
                                                            BorderBrush="{DynamicResource RtSuccessBrush}"
                                                            BorderThickness="2" />
                                                    <PathIcon Width="11"
                                                              Height="11"
                                                              Foreground="{DynamicResource RtSuccessBrush}"
                                                              Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" />
                                                </Grid>
                                            </Button>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Title}"
                                                       TextDecorations="Strikethrough"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="3"
                                                    Classes="widgetRowAction widgetDelete"
                                                    Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="删除">
                                                <PathIcon Width="11"
                                                          Height="11"
                                                          Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,40"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding IsEmpty}"
                                    Spacing="4">
                            <TextBlock Classes="caption" Text="今天没有任务" />
                            <TextBlock Classes="muted" Text="在上方快速添加一条" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <Border Background="#66000000"
                IsVisible="{Binding SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}"
                ZIndex="2">
            <Border Width="340"
                    MaxHeight="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="14"
                    CornerRadius="12"
                    Background="{DynamicResource RtSurfaceStrongBrush}"
                    BoxShadow="0 10 30 0 #77000000">
                <ScrollViewer>
                    <StackPanel DataContext="{Binding SelectedTask}" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="h2" Text="编辑任务" />
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Command="{Binding $parent[Window].DataContext.CloseEditorCommand}"
                                    ToolTip.Tip="关闭">
                                <PathIcon Width="14"
                                          Height="14"
                                          Data="M18.3,5.71L16.89,4.29L12,9.17L7.11,4.29L5.7,5.71L10.59,10.6L5.7,15.49L7.11,16.9L12,12.01L16.89,16.9L18.3,15.49L13.41,10.6L14.4,9.6L18.3,5.71Z" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="caption" Text="标题" />
                        <TextBox Text="{Binding Title}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="caption" Text="优先级" />
                                <ComboBox SelectedIndex="{Binding $parent[Window].DataContext.SelectedTaskPriorityIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="高" />
                                    <ComboBoxItem Content="中" />
                                    <ComboBoxItem Content="低" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="caption" Text="提前提醒" />
                                <NumericUpDown Minimum="0"
                                               Maximum="1440"
                                               Value="{Binding RemindOffsetMinutes}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="caption" Text="提醒时间" />
                        <TextBox PlaceholderText="例如 2026-11-17 09:30"
                                 Text="{Binding RemindAtText, Mode=TwoWay}" />
                        <TextBlock Classes="caption" Text="重复规则 RRULE" />
                        <TextBox Text="{Binding RepeatRule}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Command="{Binding $parent[Window].DataContext.CloseEditorCommand}"
                                    Content="取消" />
                            <Button Classes="primary"
                                    Click="OnSaveEditedTask"
                                    Content="保存" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>
