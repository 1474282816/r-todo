<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RTools.Desktop.MainWindow"
        xmlns:vm="using:RTools.Desktop.ViewModels"
        xmlns:models="using:RTools.Desktop.Models"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:DataType="vm:MainWindowViewModel"
        Width="880"
        Height="720"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur"
        Background="Transparent"
        Title="{Binding Title}">
    <Window.Icon>
        <WindowIcon>avares://RTools.Desktop/Assets/rtools.ico</WindowIcon>
    </Window.Icon>

    <Grid Background="Transparent">
        <ui:FANavigationView x:Name="MainNavigation"
                            PaneDisplayMode="Left"
                            AlwaysShowHeader="False"
                            IsBackButtonVisible="False"
                            IsPaneToggleButtonVisible="False"
                            IsSettingsVisible="False"
                            OpenPaneLength="224"
                            CompactPaneLength="48"
                            ItemInvoked="OnNavigationItemInvoked"
                            Background="Transparent">
            <ui:FANavigationView.PaneHeader>
                <StackPanel Margin="4,4,0,12"
                            Orientation="Horizontal"
                            Spacing="10">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="{DynamicResource SystemAccentColor}">
                        <PathIcon Width="17"
                                  Height="17"
                                  Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                  Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="rtools"
                                   Theme="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding ActiveCount, StringFormat='个人工作台 · 待完成 {0} 项'}"
                                   Theme="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ui:FANavigationView.PaneHeader>
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem x:Name="TasksNavigationItem"
                                         Content="任务"
                                         IconSource="List"
                                         Tag="tasks"
                                         IsSelected="True" />
                <ui:FANavigationViewItem x:Name="MonthNavigationItem"
                                         Content="月视图"
                                         IconSource="Calendar"
                                         Tag="month" />
                <ui:FANavigationViewItem x:Name="TransferNavigationItem"
                                         Content="局域网互传"
                                         IconSource="Send"
                                         Tag="transfer" />
                <ui:FANavigationViewItemSeparator />
                <ui:FANavigationViewItem x:Name="SettingsNavigationItem"
                                         Content="设置"
                                         IconSource="Setting"
                                         Tag="settings" />
            </ui:FANavigationView.MenuItems>
            <ui:FANavigationView.PaneFooter>
                <Border Margin="4,8,4,12"
                        Padding="12,10"
                        CornerRadius="8"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding EngineStatus}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="{Binding SyncSummary}"
                                   Theme="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </ui:FANavigationView.PaneFooter>

            <Grid>
                <Grid Margin="30,24,30,20"
                      IsVisible="{Binding IsTasksPage}"
                      RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="h1" Text="任务" />
                            <TextBlock Classes="caption"
                                       Text="今天要完成的事，集中在一处。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                            <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="{Binding ActiveCount, StringFormat='待完成 {0}'}" />
                            <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding CompletedTasks.Count, StringFormat='今日完成 {0}'}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Classes="card"
                            Margin="0,0,0,12">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox PlaceholderText="添加任务，按 Enter 创建..."
                                         Text="{Binding NewTaskTitle, Mode=TwoWay}"
                                         KeyDown="OnQuickAddKeyDown" />
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Margin="8,0,0,0"
                                        Command="{Binding AddTaskCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Width="14"
                                                  Height="14"
                                                  Foreground="#FFFFFFFF"
                                                  Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#FFFFFFFF"
                                                   Text="添加" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel Grid.Row="1"
                                        Margin="0,10,0,0"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                <TextBlock VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Classes="caption"
                                           Text="优先级" />
                                <Button Classes="priority"
                                        Classes.selected="{Binding IsHighPrioritySelected}"
                                        Command="{Binding SetHighPriorityCommand}"
                                        Content="高" />
                                <Button Classes="priority"
                                        Classes.selected="{Binding IsMediumPrioritySelected}"
                                        Command="{Binding SetMediumPriorityCommand}"
                                        Content="中" />
                                <Button Classes="priority"
                                        Classes.selected="{Binding IsLowPrioritySelected}"
                                        Command="{Binding SetLowPriorityCommand}"
                                        Content="低" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ui:FAInfoBar Grid.Row="2"
                                  Margin="0,0,0,10"
                                  Title="任务操作失败"
                                  Severity="Error"
                                  IsClosable="False"
                                  IsOpen="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                  Message="{Binding ErrorMessage}" />

                    <ScrollViewer Grid.Row="3">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,5">
                                <TextBlock Classes="caption"
                                           FontWeight="SemiBold"
                                           Text="{Binding ActiveCount, StringFormat='进行中 · {0}'}" />
                                <TextBlock Grid.Column="1"
                                           Classes="muted"
                                           Text="点击圆圈完成任务" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ActiveTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <Border Classes="taskRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <CheckBox Grid.Column="0"
                                                          Classes="taskCheck"
                                                          IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                          Command="{Binding $parent[Window].DataContext.ToggleCompleteCommand}"
                                                          CommandParameter="{Binding}" />
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="5">
                                                    <TextBlock FontSize="14"
                                                               Text="{Binding Title}"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Border Padding="7,2"
                                                                CornerRadius="4"
                                                                Background="{DynamicResource RtDangerSubtleBrush}"
                                                                IsVisible="{Binding IsHighPriority}">
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource RtDangerBrush}"
                                                                       Text="高优先级" />
                                                        </Border>
                                                        <Border Padding="7,2"
                                                                CornerRadius="4"
                                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                IsVisible="{Binding IsMediumPriority}">
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                       Text="中优先级" />
                                                        </Border>
                                                        <Border Padding="7,2"
                                                                CornerRadius="4"
                                                                Background="{DynamicResource RtSurfaceSubtleBrush}"
                                                                IsVisible="{Binding IsLowPriority}">
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource RtTextSecondaryBrush}"
                                                                       Text="低优先级" />
                                                        </Border>
                                                        <Border Padding="7,2"
                                                                CornerRadius="4"
                                                                Background="{DynamicResource RtSurfaceSubtleBrush}"
                                                                IsVisible="{Binding ReminderLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <PathIcon Width="10"
                                                                          Height="10"
                                                                          Foreground="{DynamicResource RtWarningBrush}"
                                                                          Data="M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,7H13V13H11V7M11,15H13V17H11V15Z" />
                                                                <TextBlock FontSize="10"
                                                                           Foreground="{DynamicResource RtTextSecondaryBrush}"
                                                                           Text="{Binding ReminderLabel}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Spacing="1">
                                                    <Button Classes="icon"
                                                            Command="{Binding $parent[Window].DataContext.ReorderTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="上移">
                                                        <PathIcon Width="14"
                                                                  Height="14"
                                                                  Data="M7,14L12,9L17,14H7Z" />
                                                    </Button>
                                                    <Button Classes="icon"
                                                            Command="{Binding $parent[Window].DataContext.EditTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="编辑">
                                                        <PathIcon Width="14"
                                                                  Height="14"
                                                                  Data="M3,17.25V21H6.75L17.81,9.94L14.06,6.19L3,17.25M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04Z" />
                                                    </Button>
                                                    <Button Classes="icon"
                                                            Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="删除">
                                                        <PathIcon Width="14"
                                                                  Height="14"
                                                                  Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="2,18,2,5"
                                  ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding CompletedTasks.Count}">
                                <TextBlock Classes="caption"
                                           FontWeight="SemiBold"
                                           Text="今日完成" />
                                <TextBlock Grid.Column="1"
                                           Classes="muted"
                                           Text="{Binding CompletedTasks.Count, StringFormat='{}{0} 项'}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CompletedTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <Border Classes="taskRow" Opacity="0.68">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <CheckBox Grid.Column="0"
                                                          Classes="taskCheck"
                                                          IsChecked="True"
                                                          Command="{Binding $parent[Window].DataContext.ToggleCompleteCommand}"
                                                          CommandParameter="{Binding}" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Text="{Binding Title}"
                                                           TextDecorations="Strikethrough"
                                                           TextWrapping="Wrap" />
                                                <Button Grid.Column="2"
                                                        Classes="icon"
                                                        Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="删除">
                                                    <PathIcon Width="14"
                                                              Height="14"
                                                              Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border IsVisible="{Binding IsEmpty}"
                                    Margin="0,44"
                                    Padding="28"
                                    HorizontalAlignment="Center"
                                    Classes="cardSubtle">
                                <StackPanel HorizontalAlignment="Center" Spacing="7">
                                    <PathIcon Width="28"
                                              Height="28"
                                              Foreground="{DynamicResource RtTextTertiaryBrush}"
                                              Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" />
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="今天没有待办" />
                                    <TextBlock Classes="caption"
                                               Text="在上方输入一条任务开始。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Margin="30,24,30,20"
                      IsVisible="{Binding IsMonthOpen}"
                      RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                        <Button Classes="icon"
                                Click="OnBackToTasksClicked"
                                ToolTip.Tip="返回任务">
                            <PathIcon Width="17"
                                      Height="17"
                                      Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="h1" Text="月视图" />
                            <TextBlock Classes="caption" Text="回顾本月完成任务。" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="primary"
                                Click="OnBackToTasksClicked"
                                Content="返回任务" />
                    </Grid>
                    <Border Grid.Row="1" Classes="card">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                                <Button Classes="icon"
                                        Command="{Binding PreviousMonthCommand}"
                                        ToolTip.Tip="上个月">
                                    <PathIcon Width="16"
                                              Height="16"
                                              Data="M15.41,16.59L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.59Z" />
                                </Button>
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Classes="h2"
                                           Text="{Binding MonthTitle}" />
                                <Button Grid.Column="2"
                                        Classes="icon"
                                        Command="{Binding NextMonthCommand}"
                                        ToolTip.Tip="下个月">
                                    <PathIcon Width="16"
                                              Height="16"
                                              Data="M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.59Z" />
                                </Button>
                            </Grid>
                            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,6">
                                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="日" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="一" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="二" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="三" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="四" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="五" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="六" />
                            </UniformGrid>
                            <ScrollViewer Grid.Row="2">
                                <ItemsControl ItemsSource="{Binding MonthDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MonthDayItem">
                                            <Border Classes="calendarDay"
                                                    Margin="3"
                                                    MinHeight="82"
                                                    Padding="7"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource RtSurfaceSubtleBrush}"
                                                    Classes.current="{Binding IsCurrentMonth}">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Day}" />
                                                        <Border Grid.Column="1"
                                                                Padding="5,1"
                                                                CornerRadius="7"
                                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                IsVisible="{Binding IsToday}">
                                                            <TextBlock FontSize="8"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                       Text="今天" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1"
                                                               Margin="0,5"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource RtTextTertiaryBrush}"
                                                               Text="{Binding Summary}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="2"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource RtSuccessBrush}"
                                                               Text="{Binding CompletedCount, StringFormat='完成 {0}'}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Margin="2,10,0,0"
                               Classes="muted"
                               Text="{Binding MonthTasks.Count, StringFormat='本月共完成 {0} 项'}" />
                </Grid>

                <Grid Margin="30,24,30,20"
                      IsVisible="{Binding IsSettingsOpen}"
                      RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                        <Button Classes="icon"
                                Click="OnBackToTasksClicked"
                                ToolTip.Tip="返回任务">
                            <PathIcon Width="17"
                                      Height="17"
                                      Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="h1" Text="设置" />
                            <TextBlock Classes="caption"
                                       Text="外观、同步、设备与数据管理。" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="primary"
                                Click="OnSaveSettings"
                                Content="保存设置" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  DataContext="{Binding Settings}">
                        <StackPanel Spacing="12">
                            <ui:FASettingsExpander Header="外观与行为"
                                                   Description="窗口材质、挂件和启动行为"
                                                   IconSource="DarkTheme"
                                                   IsExpanded="True">
                                <ui:FASettingsExpanderItem Content="窗口材质"
                                                           Description="Mica 与 Acrylic 由 Windows 合成，系统关闭透明效果时自动回退">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <ComboBox Width="190"
                                                  ItemsSource="{Binding Materials}"
                                                  SelectedItem="{Binding SelectedMaterial}" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="作为桌面挂件运行">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <CheckBox IsChecked="{Binding IsDesktopWidget}"
                                                  Click="OnDesktopWidgetChanged" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="吸附窗口边缘后收起">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <CheckBox IsChecked="{Binding CollapseOnSnap}" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="开机自动启动">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <CheckBox IsChecked="{Binding Autostart}" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="默认提前提醒">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <ComboBox Width="110"
                                                  ItemsSource="{Binding ReminderOffsets}"
                                                  SelectedItem="{Binding DefaultReminderOffset}" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                            </ui:FASettingsExpander>

                            <ui:FASettingsExpander Header="跨设备同步"
                                                   Description="{Binding SyncState, StringFormat='连接状态：{0}'}"
                                                   IconSource="Sync">
                                <ui:FASettingsExpanderItem Content="服务端地址"
                                                           Description="rtools 同步服务">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <TextBox Width="340" Text="{Binding SyncServerUrl}" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="一次性接入码"
                                                           Description="用于将这台设备接入现有同步空间">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <TextBox Width="210"
                                                 PlaceholderText="粘贴接入码"
                                                 Text="{Binding PairingCode}" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="设备名称">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <TextBox Width="190" Text="{Binding DeviceName}" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="同步操作">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="primary"
                                                    Command="{Binding PairCommand}"
                                                    Content="接入此设备" />
                                            <Button Command="{Binding SyncNowCommand}" Content="立即同步" />
                                            <Button Command="{Binding CreatePairingCodeCommand}"
                                                    Content="生成接入码" />
                                            <Button Command="{Binding LogoutSyncCommand}" Content="退出同步" />
                                        </StackPanel>
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="已接入设备">
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6"
                                                      ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{Binding Id}"
                                                                   Theme="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[Window].DataContext.Settings.RevokeDeviceCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="撤销" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ui:FASettingsExpanderItem>
                            </ui:FASettingsExpander>

                            <ui:FASettingsExpander Header="MCP 接入"
                                                   Description="{Binding McpRunning, StringFormat='服务运行状态：{0}'}"
                                                   IconSource="DeveloperTools">
                                <ui:FASettingsExpanderItem Content="启用 MCP 服务">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <CheckBox IsChecked="{Binding McpEnabled, Mode=OneWay}"
                                                  Command="{Binding ToggleMcpCommand}" />
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="访问令牌">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <StackPanel Width="430" Spacing="8">
                                            <TextBox IsReadOnly="True"
                                                     Text="{Binding McpToken}"
                                                     FontFamily="Cascadia Mono, Consolas" />
                                            <Button HorizontalAlignment="Left"
                                                    Command="{Binding RotateMcpTokenCommand}"
                                                    Content="重置 MCP token" />
                                        </StackPanel>
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="客户端配置模板">
                                    <TextBlock FontSize="11"
                                               FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding McpTemplates}"
                                               TextWrapping="Wrap" />
                                </ui:FASettingsExpanderItem>
                            </ui:FASettingsExpander>

                            <ui:FASettingsExpander Header="更新与组件"
                                                   Description="{Binding Version, StringFormat='rtools {0}'}"
                                                   IconSource="Refresh">
                                <ui:FASettingsExpanderItem Content="软件更新"
                                                           Description="{Binding UpdateStatus}">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Command="{Binding CheckUpdatesCommand}"
                                                    Content="检查更新" />
                                            <Button Command="{Binding DownloadUpdateCommand}"
                                                    IsVisible="{Binding UpdateAvailable}"
                                                    Classes="primary"
                                                    Content="下载并安装" />
                                        </StackPanel>
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="局域网互传">
                                    <ui:FASettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Command="{Binding ToggleTransferCommand}"
                                                    Content="启动 / 停止互传" />
                                            <Button Click="OnOpenTransferFromSettingsClicked"
                                                    Content="打开互传" />
                                        </StackPanel>
                                    </ui:FASettingsExpanderItem.Footer>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem Content="数据导入与导出"
                                                           Description="JSON、TickTick CSV 与 iCalendar">
                                    <StackPanel Spacing="8">
                                        <WrapPanel>
                                            <Button Margin="0,0,7,7"
                                                    Click="OnImportJson"
                                                    Content="导入待办 JSON" />
                                            <Button Margin="0,0,7,7"
                                                    Click="OnExportJson"
                                                    Content="导出 JSON" />
                                            <Button Margin="0,0,7,7"
                                                    Click="OnImportCsv"
                                                    Content="导入 TickTick CSV" />
                                            <Button Margin="0,0,7,7"
                                                    Click="OnExportCsv"
                                                    Content="导出 CSV" />
                                            <Button Margin="0,0,7,7"
                                                    Click="OnExportIcal"
                                                    Content="导出 iCalendar" />
                                        </WrapPanel>
                                        <TextBlock Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Text="{Binding StatusMessage}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:FASettingsExpanderItem>
                                <ui:FASettingsExpanderItem>
                                    <ui:FAInfoBar Title="操作失败"
                                                Severity="Error"
                                                IsOpen="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Message="{Binding ErrorMessage}" />
                                </ui:FASettingsExpanderItem>
                            </ui:FASettingsExpander>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2"
                          Margin="0,12,0,0"
                          DataContext="{Binding Settings}"
                          ColumnDefinitions="*,Auto">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource RtDangerBrush}"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Classes="primary"
                                Click="OnSaveSettings"
                                Content="保存设置" />
                    </Grid>
                </Grid>

                <Grid Margin="30,24,30,20"
                      IsVisible="{Binding $parent[Window].DataContext.IsTransferOpen}"
                      DataContext="{Binding Transfer}"
                      RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                        <Button Classes="icon"
                                Click="OnBackToTasksClicked"
                                ToolTip.Tip="返回任务">
                            <PathIcon Width="17"
                                      Height="17"
                                      Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="h1" Text="局域网互传" />
                            <TextBlock Classes="caption"
                                       Text="不经过服务器，直接发送文件与消息。" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Border Classes="cardSubtle" Padding="10,6">
                                <TextBlock Classes="caption"
                                           Text="{Binding IsRunning, StringFormat='服务运行：{0}'}" />
                            </Border>
                            <Button Classes="primary"
                                    Command="{Binding ToggleCommand}"
                                    Content="启动 / 停止" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="12">
                            <Border Classes="card">
                                <Grid ColumnDefinitions="1.25*,1*" ColumnSpacing="20">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h2" Text="附近设备" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox PlaceholderText="手动 IP，如 192.168.1.9:53317"
                                                     Text="{Binding ManualIp}" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding AddManualIpCommand}"
                                                    Content="连接" />
                                            <Button Grid.Column="2" Command="{Binding RefreshCommand}">
                                                <PathIcon Width="15"
                                                          Height="15"
                                                          Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12S7.58,20 12,20C15.11,20 17.76,18.09 19.03,15.39L17.27,14.46C16.35,16.52 14.32,18 12,18C8.69,18 6,15.31 6,12S8.69,6 12,6C13.66,6 15.16,6.63 16.28,7.74L13,11H20V4L17.65,6.35Z" />
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Devices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="cardSubtle" Margin="0,3">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Alias}" />
                                                                <TextBlock Classes="muted"
                                                                           Text="{Binding Address}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding $parent[Window].DataContext.Transfer.SendToCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="发送" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="muted"
                                                   Text="暂无设备。可先启动服务，或输入手动 IP。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="10">
                                        <TextBlock Classes="h2" Text="发送文件" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="primary"
                                                    Command="{Binding PickFilesCommand}"
                                                    Content="选择文件" />
                                            <Button Command="{Binding RefreshCommand}"
                                                    Content="刷新设备" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding SelectedFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="cardSubtle" Margin="0,2">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Text="{Binding}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1"
                                                                    Classes="icon"
                                                                    Command="{Binding $parent[Window].DataContext.Transfer.RemoveFileCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="移除">
                                                                <PathIcon Width="13"
                                                                          Height="13"
                                                                          Data="M18.3,5.71L16.89,4.29L12,9.17L7.11,4.29L5.7,5.71L10.59,10.6L5.7,15.49L7.11,16.9L12,12.01L16.89,16.9L18.3,15.49L13.41,10.6L18.3,5.71Z" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="caption" Text="传输进度" />
                                        <ItemsControl ItemsSource="{Binding Sessions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="cardSubtle" Margin="0,3">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="{Binding Peer}" />
                                                                <ProgressBar Value="{Binding Progress}"
                                                                             Maximum="100" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       Classes="caption"
                                                                       Text="{Binding Status}" />
                                                            <Button Grid.Column="2"
                                                                    Command="{Binding $parent[Window].DataContext.Transfer.CancelSessionCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="取消" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="会话消息" />
                                    <ItemsControl ItemsSource="{Binding Conversations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="nav"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].DataContext.Transfer.OpenConversationCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Alias}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Foreground="{DynamicResource RtWarningBrush}"
                                                                   Text="{Binding Unread, StringFormat='未读 {0}'}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Messages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="cardSubtle" Margin="0,2">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource RtTextTertiaryBrush}"
                                                                   Text="{Binding SenderAlias}" />
                                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                                        <Button HorizontalAlignment="Left"
                                                                Classes="link"
                                                                IsVisible="{Binding FilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                Command="{Binding $parent[Window].DataContext.Transfer.DeleteMessageFileCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="删除接收文件" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox PlaceholderText="输入消息"
                                                 Text="{Binding ChatText}" />
                                        <Button Grid.Column="1"
                                                Classes="primary"
                                                Command="{Binding SendChatCommand}"
                                                Content="发送" />
                                    </Grid>
                                    <WrapPanel>
                                        <Button Margin="0,0,7,7"
                                                Command="{Binding SendConversationFilesCommand}"
                                                Content="发送文件" />
                                        <Button Margin="0,0,7,7"
                                                Command="{Binding RevokeTrustCommand}"
                                                Content="撤销免确认" />
                                        <Button Margin="0,0,7,7"
                                                Command="{Binding ClearConversationCommand}"
                                                Content="清空会话" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="互传设置" />
                                    <Grid ColumnDefinitions="1*,150,1.4*" ColumnSpacing="10">
                                        <TextBox PlaceholderText="设备名称" Text="{Binding Alias}" />
                                        <NumericUpDown Grid.Column="1"
                                                       Minimum="1"
                                                       Maximum="65535"
                                                       Value="{Binding Port}" />
                                        <TextBox Grid.Column="2"
                                                 PlaceholderText="接收目录"
                                                 Text="{Binding ReceiveDir}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox PlaceholderText="PIN（可留空）" Text="{Binding Pin}" />
                                        <Button Grid.Column="1"
                                                Classes="primary"
                                                Command="{Binding SaveSettingsCommand}"
                                                Content="保存互传设置" />
                                    </Grid>
                                    <CheckBox IsChecked="{Binding AutoAcceptFavorites}"
                                              Content="自动接收已信任设备" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Foreground="{DynamicResource RtDangerBrush}"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" />
                            <TextBlock Foreground="{DynamicResource RtSuccessBrush}"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Classes="muted"
                                   Text="{Binding Fingerprint}" />
                    </Grid>
                </Grid>
            </Grid>
        </ui:FANavigationView>

        <Border Background="#70000000"
                IsVisible="{Binding SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}"
                ZIndex="10">
            <Border Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="card"
                    Background="{DynamicResource RtSurfaceStrongBrush}">
                <StackPanel DataContext="{Binding SelectedTask}" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="h2" Text="编辑任务" />
                            <TextBlock Classes="caption"
                                       Text="调整优先级、提醒和重复规则。" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="icon"
                                Command="{Binding $parent[Window].DataContext.CloseEditorCommand}"
                                ToolTip.Tip="关闭">
                            <PathIcon Width="16"
                                      Height="16"
                                      Data="M18.3,5.71L16.89,4.29L12,9.17L7.11,4.29L5.7,5.71L10.59,10.6L5.7,15.49L7.11,16.9L12,12.01L16.89,16.9L18.3,15.49L13.41,10.6L18.3,5.71Z" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock Classes="caption" Text="标题" />
                        <TextBox Text="{Binding Title}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="caption" Text="优先级" />
                            <ComboBox SelectedIndex="{Binding $parent[Window].DataContext.SelectedTaskPriorityIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="高" />
                                <ComboBoxItem Content="中" />
                                <ComboBoxItem Content="低" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="caption" Text="提前提醒（分钟）" />
                            <NumericUpDown Minimum="0"
                                           Maximum="1440"
                                           Value="{Binding RemindOffsetMinutes}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="5">
                        <TextBlock Classes="caption" Text="提醒时间" />
                        <TextBox PlaceholderText="例如 2026-11-17 09:30"
                                 Text="{Binding RemindAtText, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Classes="caption" Text="重复规则 RRULE" />
                        <TextBox Text="{Binding RepeatRule}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Command="{Binding $parent[Window].DataContext.CloseEditorCommand}"
                                Content="取消" />
                        <Button Classes="primary"
                                Click="OnSaveEditedTask"
                                Content="保存" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Background="#70000000"
                IsVisible="{Binding Transfer.HasPendingIncoming}"
                ZIndex="11">
            <Border Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="card"
                    Background="{DynamicResource RtSurfaceStrongBrush}"
                    DataContext="{Binding Transfer}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="接收文件请求" />
                    <TextBlock Text="{Binding PendingIncoming.Device.Alias}" />
                    <ItemsControl ItemsSource="{Binding PendingIncoming.Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="cardSubtle" Margin="0,2">
                                    <TextBlock Text="{Binding FileName}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted"
                               Text="{Binding ReceiveDir, StringFormat='保存到：{0}'}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Command="{Binding RejectIncomingCommand}" Content="拒绝" />
                        <Button Classes="primary"
                                Command="{Binding AcceptIncomingCommand}"
                                Content="接收" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="Border.calendarDay.current">
            <Setter Property="Background" Value="{DynamicResource RtSurfaceSubtleBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.calendarDay">
            <Setter Property="Opacity" Value="0.38" />
        </Style>
        <Style Selector="Border.calendarDay:pointerover">
            <Setter Property="Background" Value="{DynamicResource RtSurfaceStrongBrush}" />
        </Style>
    </Window.Styles>
</Window>
