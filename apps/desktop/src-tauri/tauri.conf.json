{
    "$schema":  "https://schema.tauri.app/config/2.0.0",
    "productName":  "r-todo",
    "version":  "0.0.2",
    "identifier":  "dev.rtodo.desktop",
    "build":  {
                  "beforeDevCommand":  "pnpm dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "pnpm build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "r-todo",
                                    "width":  380,
                                    "height":  620,
                                    "minWidth":  320,
                                    "minHeight":  480,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "resizable":  true,
                                    "shadow":  false,
                                    "alwaysOnBottom":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "nsis",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/icon.ico"
                            ]
               },
    "plugins":  {
                    "sql":  {
                                "preload":  [
                                                "sqlite:r-todo.db"
                                            ]
                            },
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QzMxNjYwNTM5OEUwNTgKUldSWTRKaFRZQmJER1h4d1ZMYVA3dnluSjdpN2RmMldJR09hUFFlZDY0SlFqckkvRUJhZDJVZXAK",
                                    "endpoints":  [
                                                      "https://gitee.com/renrunqi/r-todo/raw/master/apps/desktop/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}